{
	admin off
	skip_install_trust
	auto_https disable_redirects
}

{$CMC_SITE} {
	bind {$CMC_BIND:0.0.0.0}
	@unauthorized not remote_ip {$CMC_ALLOW}
	@android path /actuator/health /api/auth/login /api/auth/register /api/auth/me /api/auth/verify-email /api/auth/resend-verification /api/auth/password-reset/request /api/auth/password-reset/confirm /api/auth/password-reset/verify/* /api/auth/check-username/* /api/auth/logout /api/auth/logout-all /api/auth/sessions /api/auth/sessions/* /api/2fa/* /api/public/products /api/public/products/* /api/public/categories/active /api/cart /api/cart/summary /api/cart/validate /api/cart/items /api/cart/items/* /api/wishlist /api/wishlist/* /api/users/profile /api/users/security-settings /api/users/change-password /api/orders/my /uploads/products/* /uploads/brands/*
	@ownOrder {
		method GET OPTIONS
		path_regexp ownOrder ^/api/orders/my/[0-9]+(/timeline)?$
	}
	@publicReviews {
		method GET OPTIONS
		path_regexp publicReviews ^/api/reviews/product/[0-9]+$
	}
	@pricePreview {
		method POST OPTIONS
		path /api/checkout/price-preview
	}
	@webRecoveryPost {
		method POST OPTIONS
		path /api/auth/forgot-password /api/auth/reset-password
	}
	@webRecoveryValidate {
		method GET OPTIONS
		path /api/auth/validate-reset-token
	}
	@blocked path /api/2fa/debug /api/2fa/debug/*

	route {
		respond @unauthorized 403
		respond @blocked 404
		reverse_proxy @android {$CMC_UPSTREAM:backend:8080}
		reverse_proxy @ownOrder {$CMC_UPSTREAM:backend:8080}
		reverse_proxy @publicReviews {$CMC_UPSTREAM:backend:8080}
		reverse_proxy @pricePreview {$CMC_UPSTREAM:backend:8080}
		reverse_proxy @webRecoveryPost {$CMC_UPSTREAM:backend:8080}
		reverse_proxy @webRecoveryValidate {$CMC_UPSTREAM:backend:8080}
		respond 404
	}
}
