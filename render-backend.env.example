# ==============================================================================
# RENDER - VARIABLES DE ENTORNO DEL BACKEND (plantilla, SOLO placeholders)
# Casa de Música Castillo - Spring Boot, perfil "production" (fijado en Dockerfile)
# Copia estos nombres en Render > Environment. NUNCA escribas secretos reales aquí.
# [REQUIRED] = el arranque falla si falta | [OPTIONAL] = tiene default o habilita función
# ==============================================================================

# --- A. Plataforma -----------------------------------------------------------
# PORT lo inyecta Render automáticamente (no definir).
# [OPTIONAL] Ajuste de memoria JVM (default del Dockerfile: -Xmx384m -Xms256m)
# JAVA_OPTS=<OPTIONAL_JVM_FLAGS>

# --- B. Base de datos (Neon) -------------------------------------------------
# [REQUIRED] Sin fallback a localhost. Primario: SPRING_DATASOURCE_*
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>/security_db?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_ROLE>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>
# [OPTIONAL] Alias de compatibilidad (solo se usan si falta el SPRING_DATASOURCE_* equivalente)
DATABASE_URL=jdbc:postgresql://<NEON_HOST>/security_db?sslmode=require
PGUSER=<NEON_ROLE>
PGPASSWORD=<NEON_PASSWORD>

# --- C. Seguridad ------------------------------------------------------------
# [REQUIRED] HMAC JWT (>= 64 caracteres aleatorios). Generar NUEVO.
APP_SECURITY_JWT_SECRET=<GENERATE_NEW_SECRET_64_PLUS_CHARS>
# [REQUIRED] Clave AES de códigos de recogida: EXACTAMENTE 16, 24 o 32 caracteres ASCII. Generar NUEVA.
PICKUP_CODE_ENCRYPTION_KEY=<GENERATE_NEW_32_CHAR_KEY>

# --- D. CORS / URLs ----------------------------------------------------------
# [REQUIRED] Lista explícita separada por comas, sin "*" ni "/" final
CORS_ORIGINS=<FRONTEND_ORIGIN_1>,<FRONTEND_ORIGIN_2>
# [REQUIRED]
APP_BASE_URL=<FRONTEND_PUBLIC_URL>
FRONTEND_PUBLIC_BASE_URL=<FRONTEND_PUBLIC_URL>
BACKEND_PUBLIC_BASE_URL=<RENDER_BACKEND_PUBLIC_URL>

# --- E. Email (Brevo) --------------------------------------------------------
# [REQUIRED]
SPRING_MAIL_HOST=<SMTP_HOST>
SPRING_MAIL_PORT=<SMTP_PORT>
SPRING_MAIL_USERNAME=<BREVO_SMTP_LOGIN>
SPRING_MAIL_PASSWORD=<BREVO_SMTP_KEY>
APP_EMAIL_BREVO_API_KEY=<BREVO_API_KEY>
# [OPTIONAL]
EMAIL_SENDER_NAME=<SENDER_NAME>
EMAIL_SENDER_ADDRESS=<BREVO_VERIFIED_SENDER_EMAIL>
RESEND_API_KEY=<OPTIONAL_RESEND_API_KEY>
SENDGRID_API_KEY=<OPTIONAL_SENDGRID_API_KEY>
MAILGUN_API_KEY=<OPTIONAL_MAILGUN_API_KEY>
MAILGUN_DOMAIN=<OPTIONAL_MAILGUN_DOMAIN>

# --- F. Mercado Pago ---------------------------------------------------------
# [OPTIONAL] (MERCADO_PAGO_ENABLED default en producción: false)
MERCADO_PAGO_ENABLED=<true_or_false>
MERCADO_PAGO_ENVIRONMENT=<production_or_sandbox>
MERCADO_PAGO_ACCESS_TOKEN=<MP_ACCESS_TOKEN>
MERCADO_PAGO_PUBLIC_KEY=<MP_PUBLIC_KEY>
MERCADO_PAGO_WEBHOOK_SECRET=<MP_WEBHOOK_SECRET>

# --- G. Cloudinary -----------------------------------------------------------
# [REQUIRED] (STORAGE_PROVIDER=CLOUDINARY fijo en producción)
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# --- H. Supabase (backups off-site) -----------------------------------------
# [OPTIONAL]
SUPABASE_URL=<SUPABASE_PROJECT_URL>
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_BUCKET=<SUPABASE_BUCKET_NAME>

# --- I. SMS (Sinch) ----------------------------------------------------------
# [REQUIRED]
APP_NOTIFICATION_SMS_PROJECT_ID=<SINCH_PROJECT_ID>
APP_NOTIFICATION_SMS_ACCESS_KEY_ID=<SINCH_ACCESS_KEY_ID>
APP_NOTIFICATION_SMS_SECRET_KEY=<SINCH_SECRET_KEY>
# [OPTIONAL]
SMS_PROVIDER=<sinch>
SINCH_FROM_NUMBER=<SINCH_SENDER_NUMBER>

# --- J. Tienda / Alexa (todos OPTIONAL, tienen default) ----------------------
STORE_NAME=<STORE_NAME>
STORE_ADDRESS=<STORE_ADDRESS>
STORE_PHONE=<STORE_PHONE>
STORE_WHATSAPP=<STORE_WHATSAPP>
STORE_FACEBOOK=<STORE_FACEBOOK_URL>
STORE_HOURS=<STORE_HOURS>
STORE_PAYMENT_METHODS=<STORE_PAYMENT_METHODS>
STORE_WARRANTY_INFO=<STORE_WARRANTY_INFO>

# --- Solo desarrollo local (perfil "local"; NO usar en Render) ---------------
# FLYWAY_ADMIN_PASSWORD=<LOCAL_POSTGRES_ADMIN_PASSWORD>
